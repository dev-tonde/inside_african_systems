{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeos-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeos",
      "database_id": "local"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0,30 5-16 * * *", "0 17 * * *"]
  }
}
