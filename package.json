{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "content:check": "npm run check -w @lifeos/content-factory",
    "content:studio": "npm run studio -w @lifeos/content-factory",
    "content:frame": "npm run pilot:frame -w @lifeos/content-factory",
    "content:thumbnail": "npm run pilot:thumbnail -w @lifeos/content-factory",
    "content:render": "npm run pilot:render -w @lifeos/content-factory"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
